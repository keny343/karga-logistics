# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=4100

# Local development against a native PostgreSQL or the docker-compose service.
DATABASE_URL=postgresql://karga:karga_dev@localhost:5432/karga
# Managed providers (Render, Aiven, Neon) terminate TLS: set this to true there.
DATABASE_SSL=false

# Origins allowed to call the API with credentials, comma separated.
CORS_ORIGINS=http://localhost:5175

LOG_LEVEL=info
